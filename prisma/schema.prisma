// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())

  tasks        Task[]
  dailyStats   DailyStats[]
  noteFolders  NoteFolder[]
  notes        Note[]

  // NextAuth required fields
  sessions     Session[]
  accounts     Account[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Task {
  id            String   @id @default(cuid())
  title         String
  minutes       Int      @default(25)
  completed     Boolean  @default(false)
  date          String   // YYYY-MM-DD
  createdAt     DateTime @default(now())
  focusedMinutes Int     @default(0)
  order         Int      @default(0)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyStats {
  id             String   @id @default(cuid())
  date           String   // YYYY-MM-DD
  focusMinutes   Int      @default(0)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Pastas de notas. Arvore por auto-relacao: parentId nulo = raiz.
// O limite de MAX_SUBFOLDERS filhas por pasta e regra de aplicacao
// (validada na API), nao ha como expressa-la no schema.
model NoteFolder {
  id        String       @id @default(cuid())
  name      String
  parentId  String?
  parent    NoteFolder?  @relation("NoteFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NoteFolder[] @relation("NoteFolderTree")
  notes     Note[]
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, parentId])
}

model Note {
  id        String      @id @default(cuid())
  title     String      @default("")
  content   String      @default("")
  folderId  String?
  folder    NoteFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  pinned    Boolean     @default(false)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, folderId])
}
